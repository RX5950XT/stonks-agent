# Copy to .env (gitignored) so the launchers stop asking for the model
# connection on every restart. Only STONKS_* keys are accepted.
# The API key stays in process memory: it never reaches the database,
# artifacts, logs, or browser storage.

STONKS_LLM_BASE_URL=https://api.openai.com
STONKS_LLM_ENDPOINT=/v1/chat/completions
STONKS_LLM_MODEL=gpt-5
STONKS_LLM_API_KEY=replace-with-your-own-key

STONKS_LLM_INPUT_COST_PER_MILLION=1.25
STONKS_LLM_CACHED_INPUT_COST_PER_MILLION=0.125
STONKS_LLM_CACHE_WRITE_INPUT_COST_PER_MILLION=1.25
STONKS_LLM_OUTPUT_COST_PER_MILLION=10.0

STONKS_LLM_MAX_OUTPUT_TOKENS=4096
STONKS_LLM_MAX_TOTAL_TOKENS=32768
STONKS_LLM_MAX_COST_USD=1.00
STONKS_LLM_MAX_TRANSIENT_RETRIES=2
STONKS_LLM_MAX_REPAIRS=1
STONKS_LLM_TIMEOUT_SECONDS=60
STONKS_LLM_MAX_RESPONSE_BYTES=1048576
