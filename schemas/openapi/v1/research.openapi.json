{
  "components": {
    "schemas": {
      "CreateResearchRunBody": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]{0,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "instrument_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Instrument Id",
            "type": "string"
          },
          "language": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$",
            "title": "Language",
            "type": "string"
          },
          "model_policy_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
            "title": "Model Policy Id",
            "type": "string"
          },
          "research_profile_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
            "title": "Research Profile Id",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid",
            "title": "Snapshot Id",
            "type": "string"
          },
          "symbol": {
            "pattern": "^[A-Z0-9][A-Z0-9.-]{0,15}$",
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "instrument_id",
          "symbol",
          "as_of",
          "snapshot_id",
          "research_profile_id",
          "model_policy_id",
          "language",
          "idempotency_key"
        ],
        "title": "CreateResearchRunBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
