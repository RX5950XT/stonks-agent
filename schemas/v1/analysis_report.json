{
  "$defs": {
    "ClaimCertainty": {
      "enum": [
        "observed",
        "qualified",
        "hypothesis"
      ],
      "title": "ClaimCertainty",
      "type": "string"
    },
    "DataQualityStatus": {
      "enum": [
        "available",
        "missing",
        "not_supported",
        "fallback",
        "stale",
        "estimated",
        "partial",
        "fetch_failed",
        "conflict"
      ],
      "title": "DataQualityStatus",
      "type": "string"
    },
    "ReportClaim": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "minLength": 1,
          "title": "Assertion",
          "type": "string"
        },
        "certainty": {
          "$ref": "#/$defs/ClaimCertainty"
        },
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "data_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataQualityStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "assertion",
        "certainty",
        "data_quality"
      ],
      "title": "ReportClaim",
      "type": "object"
    },
    "ReportReference": {
      "additionalProperties": false,
      "description": "Exact immutable trading reference included in the report JSON truth.",
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "ref_id": {
          "format": "uuid",
          "title": "Ref Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "content_hash"
      ],
      "title": "ReportReference",
      "type": "object"
    },
    "ReportRendering": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "content_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Content Ref",
          "type": "string"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "template_version": {
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        }
      },
      "required": [
        "format",
        "template_version",
        "content_hash",
        "content_ref"
      ],
      "title": "ReportRendering",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_guardrails": {
      "items": {
        "type": "string"
      },
      "title": "Action Guardrails",
      "type": "array"
    },
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "catalysts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Catalysts",
      "type": "array"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "conclusion": {
      "minLength": 1,
      "title": "Conclusion",
      "type": "string"
    },
    "confidence": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Confidence",
      "type": "string"
    },
    "data_limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Data Limitations",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "fill_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportReference"
      },
      "title": "Fill Refs",
      "type": "array"
    },
    "generation_artifact_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Artifact Ref"
    },
    "generator_version": {
      "minLength": 1,
      "title": "Generator Version",
      "type": "string"
    },
    "language": {
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "order_intent_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportReference"
      },
      "title": "Order Intent Refs",
      "type": "array"
    },
    "outcome_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportReference"
      },
      "title": "Outcome Refs",
      "type": "array"
    },
    "owner_subject": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+=-]{0,254}$",
      "title": "Owner Subject",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "portfolio_target_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportReference"
      },
      "title": "Portfolio Target Refs",
      "type": "array"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "renderings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportRendering"
      },
      "title": "Renderings",
      "type": "array"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "report_type": {
      "minLength": 1,
      "title": "Report Type",
      "type": "string"
    },
    "risk_decision_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportReference"
      },
      "title": "Risk Decision Refs",
      "type": "array"
    },
    "risks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "scenarios": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Score",
      "type": "string"
    },
    "signal_attribution": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Signal Attribution",
      "type": "array"
    },
    "signal_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Signal Ids",
      "type": "array"
    },
    "subject": {
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "run_id",
    "owner_subject",
    "subject",
    "as_of",
    "language",
    "report_type",
    "conclusion",
    "score",
    "confidence",
    "action_guardrails",
    "evidence_refs",
    "generator_version",
    "policy_version"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
