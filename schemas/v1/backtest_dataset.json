{
  "$defs": {
    "BacktestBar": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "title": "Available At",
          "type": "string"
        },
        "bar_id": {
          "format": "uuid",
          "title": "Bar Id",
          "type": "string"
        },
        "close": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Close",
          "type": "string"
        },
        "closes_at": {
          "title": "Closes At",
          "type": "string"
        },
        "high": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "High",
          "type": "string"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "low": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Low",
          "type": "string"
        },
        "open": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Open",
          "type": "string"
        },
        "opens_at": {
          "title": "Opens At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "tradable": {
          "title": "Tradable",
          "type": "boolean"
        },
        "volume": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "bar_id",
        "instrument_id",
        "opens_at",
        "closes_at",
        "available_at",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "source_ref",
        "source_hash",
        "tradable"
      ],
      "title": "BacktestBar",
      "type": "object"
    },
    "BacktestCalendar": {
      "additionalProperties": false,
      "properties": {
        "calendar_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Calendar Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/BacktestSession"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Sessions",
          "type": "array"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "calendar_id",
        "version",
        "timezone",
        "sessions"
      ],
      "title": "BacktestCalendar",
      "type": "object"
    },
    "BacktestInstrument": {
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "const": "equity",
          "title": "Asset Class",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "mic": {
          "pattern": "^[A-Z0-9]{4}$",
          "title": "Mic",
          "type": "string"
        },
        "price_quantum": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Price Quantum",
          "type": "string"
        },
        "quantity_quantum": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Quantity Quantum",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9][A-Z0-9.-]{0,31}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "symbol",
        "mic",
        "asset_class",
        "currency",
        "price_quantum",
        "quantity_quantum"
      ],
      "title": "BacktestInstrument",
      "type": "object"
    },
    "BacktestSession": {
      "additionalProperties": false,
      "properties": {
        "break_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Break End"
        },
        "break_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Break Start"
        },
        "closes_at": {
          "title": "Closes At",
          "type": "string"
        },
        "mic": {
          "pattern": "^[A-Z0-9]{4}$",
          "title": "Mic",
          "type": "string"
        },
        "opens_at": {
          "title": "Opens At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_date": {
          "format": "date",
          "title": "Session Date",
          "type": "string"
        }
      },
      "required": [
        "session_date",
        "mic",
        "opens_at",
        "closes_at"
      ],
      "title": "BacktestSession",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjustment": {
      "const": "split_dividend_adjusted",
      "title": "Adjustment",
      "type": "string"
    },
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "bars": {
      "items": {
        "$ref": "#/$defs/BacktestBar"
      },
      "maxItems": 1000000,
      "minItems": 1,
      "title": "Bars",
      "type": "array"
    },
    "calendar": {
      "$ref": "#/$defs/BacktestCalendar"
    },
    "dataset_id": {
      "format": "uuid",
      "title": "Dataset Id",
      "type": "string"
    },
    "instruments": {
      "items": {
        "$ref": "#/$defs/BacktestInstrument"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Instruments",
      "type": "array"
    },
    "interval": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Interval",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "as_of",
    "interval",
    "adjustment",
    "instruments",
    "calendar",
    "bars"
  ],
  "title": "BacktestDataset",
  "type": "object"
}
