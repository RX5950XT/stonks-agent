{
  "additionalProperties": false,
  "properties": {
    "asset_class": {
      "const": "equity",
      "title": "Asset Class",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "instrument_id": {
      "format": "uuid",
      "title": "Instrument Id",
      "type": "string"
    },
    "mic": {
      "pattern": "^[A-Z0-9]{4}$",
      "title": "Mic",
      "type": "string"
    },
    "price_quantum": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Price Quantum",
      "type": "string"
    },
    "quantity_quantum": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Quantity Quantum",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "pattern": "^[A-Z0-9][A-Z0-9.-]{0,31}$",
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "instrument_id",
    "symbol",
    "mic",
    "asset_class",
    "currency",
    "price_quantum",
    "quantity_quantum"
  ],
  "title": "BacktestInstrument",
  "type": "object"
}
