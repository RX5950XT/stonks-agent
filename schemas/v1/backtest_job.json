{
  "$defs": {
    "BacktestBar": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "title": "Available At",
          "type": "string"
        },
        "bar_id": {
          "format": "uuid",
          "title": "Bar Id",
          "type": "string"
        },
        "close": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Close",
          "type": "string"
        },
        "closes_at": {
          "title": "Closes At",
          "type": "string"
        },
        "high": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "High",
          "type": "string"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "low": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Low",
          "type": "string"
        },
        "open": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Open",
          "type": "string"
        },
        "opens_at": {
          "title": "Opens At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "tradable": {
          "title": "Tradable",
          "type": "boolean"
        },
        "volume": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "bar_id",
        "instrument_id",
        "opens_at",
        "closes_at",
        "available_at",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "source_ref",
        "source_hash",
        "tradable"
      ],
      "title": "BacktestBar",
      "type": "object"
    },
    "BacktestCalendar": {
      "additionalProperties": false,
      "properties": {
        "calendar_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Calendar Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/BacktestSession"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Sessions",
          "type": "array"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "calendar_id",
        "version",
        "timezone",
        "sessions"
      ],
      "title": "BacktestCalendar",
      "type": "object"
    },
    "BacktestCashBalance": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "quantum": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Quantum",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount",
        "quantum"
      ],
      "title": "BacktestCashBalance",
      "type": "object"
    },
    "BacktestCostModel": {
      "additionalProperties": false,
      "properties": {
        "base_slippage_bps": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Base Slippage Bps",
          "type": "string"
        },
        "fee_bps": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Fee Bps",
          "type": "string"
        },
        "fee_quantum": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Fee Quantum",
          "type": "string"
        },
        "half_spread_bps": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Half Spread Bps",
          "type": "string"
        },
        "market_impact_bps_at_max_participation": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Market Impact Bps At Max Participation",
          "type": "string"
        },
        "max_volume_participation": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Max Volume Participation",
          "type": "string"
        },
        "minimum_fee": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Minimum Fee",
          "type": "string"
        },
        "model_kind": {
          "const": "deterministic_next_bar",
          "title": "Model Kind",
          "type": "string"
        },
        "per_unit_fee": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Per Unit Fee",
          "type": "string"
        },
        "realism_claim": {
          "const": "reference_model_not_market_replay",
          "title": "Realism Claim",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "model_kind",
        "realism_claim",
        "max_volume_participation",
        "half_spread_bps",
        "base_slippage_bps",
        "market_impact_bps_at_max_participation",
        "fee_bps",
        "per_unit_fee",
        "minimum_fee",
        "fee_quantum"
      ],
      "title": "BacktestCostModel",
      "type": "object"
    },
    "BacktestDataset": {
      "additionalProperties": false,
      "properties": {
        "adjustment": {
          "const": "split_dividend_adjusted",
          "title": "Adjustment",
          "type": "string"
        },
        "as_of": {
          "title": "As Of",
          "type": "string"
        },
        "bars": {
          "items": {
            "$ref": "#/$defs/BacktestBar"
          },
          "maxItems": 1000000,
          "minItems": 1,
          "title": "Bars",
          "type": "array"
        },
        "calendar": {
          "$ref": "#/$defs/BacktestCalendar"
        },
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        },
        "instruments": {
          "items": {
            "$ref": "#/$defs/BacktestInstrument"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instruments",
          "type": "array"
        },
        "interval": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Interval",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "as_of",
        "interval",
        "adjustment",
        "instruments",
        "calendar",
        "bars"
      ],
      "title": "BacktestDataset",
      "type": "object"
    },
    "BacktestEngineKind": {
      "enum": [
        "reference",
        "nautilus",
        "lean"
      ],
      "title": "BacktestEngineKind",
      "type": "string"
    },
    "BacktestInstrument": {
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "const": "equity",
          "title": "Asset Class",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "mic": {
          "pattern": "^[A-Z0-9]{4}$",
          "title": "Mic",
          "type": "string"
        },
        "price_quantum": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Price Quantum",
          "type": "string"
        },
        "quantity_quantum": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Quantity Quantum",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9][A-Z0-9.-]{0,31}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "symbol",
        "mic",
        "asset_class",
        "currency",
        "price_quantum",
        "quantity_quantum"
      ],
      "title": "BacktestInstrument",
      "type": "object"
    },
    "BacktestOrder": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "issued_at": {
          "title": "Issued At",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "order_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Order Hash",
          "type": "string"
        },
        "order_id": {
          "format": "uuid",
          "title": "Order Id",
          "type": "string"
        },
        "order_type": {
          "$ref": "#/$defs/BacktestOrderType"
        },
        "quantity": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "side": {
          "$ref": "#/$defs/BacktestOrderSide"
        },
        "simulation_only": {
          "const": true,
          "default": true,
          "title": "Simulation Only",
          "type": "boolean"
        },
        "strategy_event_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Strategy Event Ref",
          "type": "string"
        },
        "time_in_force": {
          "$ref": "#/$defs/BacktestTimeInForce"
        },
        "valid_until": {
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "sequence",
        "instrument_id",
        "side",
        "order_type",
        "quantity",
        "time_in_force",
        "issued_at",
        "valid_until",
        "strategy_event_ref",
        "order_hash"
      ],
      "title": "BacktestOrder",
      "type": "object"
    },
    "BacktestOrderSide": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "BacktestOrderSide",
      "type": "string"
    },
    "BacktestOrderType": {
      "enum": [
        "market",
        "limit"
      ],
      "title": "BacktestOrderType",
      "type": "string"
    },
    "BacktestPosition": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "quantity": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "quantity_quantum": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Quantity Quantum",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "quantity",
        "quantity_quantum"
      ],
      "title": "BacktestPosition",
      "type": "object"
    },
    "BacktestRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "deterministic": {
          "const": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "engine": {
          "$ref": "#/$defs/BacktestEngineKind"
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "image_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Digest"
        },
        "runtime_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "engine_version",
        "adapter_version",
        "runtime_hash",
        "deterministic"
      ],
      "title": "BacktestRuntimeIdentity",
      "type": "object"
    },
    "BacktestSession": {
      "additionalProperties": false,
      "properties": {
        "break_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Break End"
        },
        "break_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Break Start"
        },
        "closes_at": {
          "title": "Closes At",
          "type": "string"
        },
        "mic": {
          "pattern": "^[A-Z0-9]{4}$",
          "title": "Mic",
          "type": "string"
        },
        "opens_at": {
          "title": "Opens At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_date": {
          "format": "date",
          "title": "Session Date",
          "type": "string"
        }
      },
      "required": [
        "session_date",
        "mic",
        "opens_at",
        "closes_at"
      ],
      "title": "BacktestSession",
      "type": "object"
    },
    "BacktestTimeInForce": {
      "enum": [
        "day",
        "gtc",
        "ioc"
      ],
      "title": "BacktestTimeInForce",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_generation": {
      "minimum": 1,
      "title": "Attempt Generation",
      "type": "integer"
    },
    "attempt_nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Attempt Nonce",
      "type": "string"
    },
    "base_currency": {
      "default": "USD",
      "pattern": "^[A-Z]{3}$",
      "title": "Base Currency",
      "type": "string"
    },
    "cost_model": {
      "$ref": "#/$defs/BacktestCostModel"
    },
    "dataset": {
      "$ref": "#/$defs/BacktestDataset"
    },
    "dataset_artifact_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Dataset Artifact Ref",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "string"
    },
    "execution_mode": {
      "const": "backtest",
      "default": "backtest",
      "title": "Execution Mode",
      "type": "string"
    },
    "initial_cash": {
      "items": {
        "$ref": "#/$defs/BacktestCashBalance"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Initial Cash",
      "type": "array"
    },
    "initial_positions": {
      "items": {
        "$ref": "#/$defs/BacktestPosition"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Initial Positions",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/BacktestOrder"
      },
      "maxItems": 1000000,
      "minItems": 1,
      "title": "Orders",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "title": "Requested At",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/BacktestRuntimeIdentity"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_artifact_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Strategy Artifact Ref",
      "type": "string"
    },
    "strategy_content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Strategy Content Hash",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "job_id",
    "attempt_generation",
    "attempt_nonce",
    "runtime",
    "strategy_artifact_ref",
    "strategy_content_hash",
    "dataset_artifact_ref",
    "dataset",
    "cost_model",
    "orders",
    "initial_cash",
    "initial_positions",
    "requested_at",
    "deadline"
  ],
  "title": "BacktestJob",
  "type": "object"
}
