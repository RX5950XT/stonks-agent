{
  "$defs": {
    "BacktestOrderStatus": {
      "enum": [
        "accepted",
        "partially_filled",
        "filled",
        "rejected",
        "cancelled",
        "expired"
      ],
      "title": "BacktestOrderStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_quantity": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Command Quantity",
      "type": "string"
    },
    "filled_quantity": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Filled Quantity",
      "type": "string"
    },
    "order_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Order Hash",
      "type": "string"
    },
    "order_id": {
      "format": "uuid",
      "title": "Order Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "remaining_quantity": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Remaining Quantity",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/BacktestOrderStatus"
    }
  },
  "required": [
    "order_id",
    "order_hash",
    "status",
    "command_quantity",
    "filled_quantity",
    "remaining_quantity"
  ],
  "title": "BacktestOrderOutcome",
  "type": "object"
}
