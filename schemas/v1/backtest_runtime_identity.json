{
  "$defs": {
    "BacktestEngineKind": {
      "enum": [
        "reference",
        "nautilus",
        "lean"
      ],
      "title": "BacktestEngineKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "deterministic": {
      "const": true,
      "title": "Deterministic",
      "type": "boolean"
    },
    "engine": {
      "$ref": "#/$defs/BacktestEngineKind"
    },
    "engine_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "image_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Digest"
    },
    "runtime_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "engine",
    "engine_version",
    "adapter_version",
    "runtime_hash",
    "deterministic"
  ],
  "title": "BacktestRuntimeIdentity",
  "type": "object"
}
