{
  "$defs": {
    "DataQualityStatus": {
      "enum": [
        "available",
        "missing",
        "not_supported",
        "fallback",
        "stale",
        "estimated",
        "partial",
        "fetch_failed",
        "conflict"
      ],
      "title": "DataQualityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completeness": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Completeness",
      "type": "string"
    },
    "fallback_chain": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Chain",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DataQualityStatus"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "completeness"
  ],
  "title": "DataQuality",
  "type": "object"
}
