{
  "$defs": {
    "DraftArtifactKind": {
      "enum": [
        "source",
        "predictions",
        "static_scan"
      ],
      "title": "DraftArtifactKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "byte_count": {
      "maximum": 16777216,
      "minimum": 1,
      "title": "Byte Count",
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "draft_only": {
      "const": true,
      "title": "Draft Only",
      "type": "boolean"
    },
    "kind": {
