    },
    "media_type": {
      "enum": [
        "text/x-python",
        "application/json"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "content_hash",
    "byte_count",
    "media_type",
    "draft_only"
  ],
  "title": "DraftArtifact",
  "type": "object"
