{
  "$defs": {
    "JournalSide": {
      "enum": [
        "debit",
        "credit"
      ],
      "title": "JournalSide",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account": {
      "minLength": 1,
      "title": "Account",
      "type": "string"
    },
    "amount": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Amount",
      "type": "string"
    },
    "commodity": {
      "minLength": 1,
      "title": "Commodity",
      "type": "string"
    },
    "memo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memo"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/JournalSide"
    }
  },
  "required": [
    "account",
    "commodity",
    "side",
    "amount"
  ],
  "title": "JournalPosting",
  "type": "object"
}
