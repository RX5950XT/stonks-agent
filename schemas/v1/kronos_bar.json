{
  "$defs": {
    "VolumeQuality": {
      "description": "How the volume input was obtained before inference.",
      "enum": [
        "observed",
        "estimated",
        "missing"
      ],
      "title": "VolumeQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A point-in-time OHLCV bar admitted to a forecast request.",
  "properties": {
    "amount": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount"
    },
    "available_at": {
      "title": "Available At",
      "type": "string"
    },
    "close": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Close",
      "type": "string"
    },
    "event_time": {
      "title": "Event Time",
      "type": "string"
    },
    "high": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "High",
      "type": "string"
    },
    "low": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Low",
      "type": "string"
    },
    "open": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Open",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "volume": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Volume"
    },
    "volume_quality": {
      "$ref": "#/$defs/VolumeQuality"
    }
  },
  "required": [
    "event_time",
    "available_at",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "volume_quality"
  ],
  "title": "KronosBar",
  "type": "object"
}
