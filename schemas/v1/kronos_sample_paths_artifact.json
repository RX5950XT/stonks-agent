{
  "$defs": {
    "KronosForecastPath": {
      "additionalProperties": false,
      "description": "An unaggregated forecast path tied to one explicit seed.",
      "properties": {
        "path_index": {
          "minimum": 0,
          "title": "Path Index",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/KronosForecastPoint"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "path_index",
        "seed",
        "points"
      ],
      "title": "KronosForecastPath",
      "type": "object"
    },
    "KronosForecastPoint": {
      "additionalProperties": false,
      "description": "One raw forecast bar in one stochastic path.",
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "close": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Close",
          "type": "string"
        },
        "high": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "High",
          "type": "string"
        },
        "low": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Low",
          "type": "string"
        },
        "open": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Open",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "volume": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "amount"
      ],
      "title": "KronosForecastPoint",
      "type": "object"
    },
    "KronosInterval": {
      "const": "1d",
      "type": "string"
    },
    "KronosProfile": {
      "enum": [
        "cpu",
        "cuda"
      ],
      "type": "string"
    },
    "KronosRuntimeIdentity": {
      "additionalProperties": false,
      "description": "Exact code, model, tokenizer, manifest, and runtime identity.",
      "properties": {
        "device": {
          "$ref": "#/$defs/KronosProfile"
        },
        "inference_code_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Inference Code Version",
          "type": "string"
        },
        "manifest_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Hash",
          "type": "string"
        },
        "model_artifact_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Artifact Hash",
          "type": "string"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Model Revision",
          "type": "string"
        },
        "runtime_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tokenizer_artifact_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Tokenizer Artifact Hash",
          "type": "string"
        },
        "tokenizer_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tokenizer Id",
          "type": "string"
        },
        "tokenizer_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Tokenizer Revision",
          "type": "string"
        },
        "torch_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        },
        "upstream_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Upstream Commit",
          "type": "string"
        },
        "worker_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Worker Version",
          "type": "string"
        }
      },
      "required": [
        "worker_version",
        "upstream_commit",
        "model_id",
        "model_revision",
        "model_artifact_hash",
        "tokenizer_id",
        "tokenizer_revision",
        "tokenizer_artifact_hash",
        "manifest_hash",
        "runtime_hash",
        "device",
        "torch_version",
        "inference_code_version"
      ],
      "title": "KronosRuntimeIdentity",
      "type": "object"
    },
    "KronosSamplingPolicy": {
      "additionalProperties": false,
      "description": "Explicit deterministic path seeds; the worker runs one seed at a time.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_policy": {
          "const": "explicit-sequential-v1",
          "title": "Seed Policy",
          "type": "string"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        },
        "temperature": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Temperature",
          "type": "string"
        },
        "top_k": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        },
        "top_p": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Top P",
          "type": "string"
        }
      },
      "required": [
        "seed_policy",
        "seeds",
        "temperature",
        "top_k",
        "top_p"
      ],
      "title": "KronosSamplingPolicy",
      "type": "object"
    },
    "VolumeQuality": {
      "description": "How the volume input was obtained before inference.",
      "enum": [
        "observed",
        "estimated",
        "missing"
      ],
      "title": "VolumeQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Lease-secret-free stochastic output used as the replay starting point.",
  "properties": {
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "dataset_snapshot_id": {
      "format": "uuid",
      "title": "Dataset Snapshot Id",
      "type": "string"
    },
    "future_timestamps": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Future Timestamps",
      "type": "array"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "input_last_close": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Input Last Close",
      "type": "string"
    },
    "input_volume_quality": {
      "$ref": "#/$defs/VolumeQuality"
    },
    "input_window_end": {
      "title": "Input Window End",
      "type": "string"
    },
    "input_window_start": {
      "title": "Input Window Start",
      "type": "string"
    },
    "instrument_id": {
      "format": "uuid",
      "title": "Instrument Id",
      "type": "string"
    },
    "interval": {
      "$ref": "#/$defs/KronosInterval"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "paths": {
      "items": {
        "$ref": "#/$defs/KronosForecastPath"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Paths",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/KronosRuntimeIdentity"
    },
    "sampling": {
      "$ref": "#/$defs/KronosSamplingPolicy"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "instrument_id",
    "dataset_snapshot_id",
    "as_of",
    "interval",
    "input_window_start",
    "input_window_end",
    "input_last_close",
    "input_volume_quality",
    "runtime",
    "sampling",
    "future_timestamps",
    "paths",
    "generated_at",
    "latency_ms"
  ],
  "title": "KronosSamplePathsArtifact",
  "type": "object"
}
