{
  "$defs": {
    "KronosBar": {
      "additionalProperties": false,
      "description": "A point-in-time OHLCV bar admitted to a forecast request.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        },
        "close": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Close",
          "type": "string"
        },
        "event_time": {
          "title": "Event Time",
          "type": "string"
        },
        "high": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "High",
          "type": "string"
        },
        "low": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Low",
          "type": "string"
        },
        "open": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Open",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume"
        },
        "volume_quality": {
          "$ref": "#/$defs/VolumeQuality"
        }
      },
      "required": [
        "event_time",
        "available_at",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "volume_quality"
      ],
      "title": "KronosBar",
      "type": "object"
    },
    "KronosInterval": {
      "const": "1d",
      "type": "string"
    },
    "KronosProfile": {
      "enum": [
        "cpu",
        "cuda"
      ],
      "type": "string"
    },
    "KronosRuntimeIdentity": {
      "additionalProperties": false,
      "description": "Exact code, model, tokenizer, manifest, and runtime identity.",
      "properties": {
        "device": {
          "$ref": "#/$defs/KronosProfile"
        },
        "inference_code_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Inference Code Version",
          "type": "string"
        },
        "manifest_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Hash",
          "type": "string"
        },
        "model_artifact_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Artifact Hash",
          "type": "string"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Model Revision",
          "type": "string"
        },
        "runtime_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tokenizer_artifact_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Tokenizer Artifact Hash",
          "type": "string"
        },
        "tokenizer_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tokenizer Id",
          "type": "string"
        },
        "tokenizer_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Tokenizer Revision",
          "type": "string"
        },
        "torch_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        },
        "upstream_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Upstream Commit",
          "type": "string"
        },
        "worker_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Worker Version",
          "type": "string"
        }
      },
      "required": [
        "worker_version",
        "upstream_commit",
        "model_id",
        "model_revision",
        "model_artifact_hash",
        "tokenizer_id",
        "tokenizer_revision",
        "tokenizer_artifact_hash",
        "manifest_hash",
        "runtime_hash",
        "device",
        "torch_version",
        "inference_code_version"
      ],
      "title": "KronosRuntimeIdentity",
      "type": "object"
    },
    "KronosSamplingPolicy": {
      "additionalProperties": false,
      "description": "Explicit deterministic path seeds; the worker runs one seed at a time.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_policy": {
          "const": "explicit-sequential-v1",
          "title": "Seed Policy",
          "type": "string"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        },
        "temperature": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Temperature",
          "type": "string"
        },
        "top_k": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        },
        "top_p": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Top P",
          "type": "string"
        }
      },
      "required": [
        "seed_policy",
        "seeds",
        "temperature",
        "top_k",
        "top_p"
      ],
      "title": "KronosSamplingPolicy",
      "type": "object"
    },
    "VolumeQuality": {
      "description": "How the volume input was obtained before inference.",
      "enum": [
        "observed",
        "estimated",
        "missing"
      ],
      "title": "VolumeQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Lease-fenced request containing only data and inference authority.",
  "properties": {
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "attempt_generation": {
      "minimum": 1,
      "title": "Attempt Generation",
      "type": "integer"
    },
    "attempt_nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Attempt Nonce",
      "type": "string"
    },
    "bars": {
      "items": {
        "$ref": "#/$defs/KronosBar"
      },
      "maxItems": 512,
      "minItems": 2,
      "title": "Bars",
      "type": "array"
    },
    "data_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Data Hash",
      "type": "string"
    },
    "dataset_snapshot_id": {
      "format": "uuid",
      "title": "Dataset Snapshot Id",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "string"
    },
    "future_timestamps": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Future Timestamps",
      "type": "array"
    },
    "instrument_id": {
      "format": "uuid",
      "title": "Instrument Id",
      "type": "string"
    },
    "interval": {
      "$ref": "#/$defs/KronosInterval"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "mic": {
      "pattern": "^[A-Z0-9]{4}$",
      "title": "Mic",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/KronosProfile"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/KronosRuntimeIdentity"
    },
    "sampling": {
      "$ref": "#/$defs/KronosSamplingPolicy"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_artifact_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Snapshot Artifact Ref",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "job_id",
    "attempt_generation",
    "attempt_nonce",
    "profile",
    "instrument_id",
    "mic",
    "dataset_snapshot_id",
    "snapshot_artifact_ref",
    "data_hash",
    "as_of",
    "interval",
    "bars",
    "future_timestamps",
    "runtime",
    "sampling",
    "deadline"
  ],
  "title": "KronosWorkerRequest",
  "type": "object"
}
