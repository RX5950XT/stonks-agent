{
  "additionalProperties": false,
  "properties": {
    "external_ref": {
      "minLength": 1,
      "title": "External Ref",
      "type": "string"
    },
    "observation_deadline": {
      "title": "Observation Deadline",
      "type": "string"
    },
    "platform": {
      "minLength": 1,
      "title": "Platform",
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "published_at": {
      "title": "Published At",
      "type": "string"
    },
    "remote_authority": {
      "const": "evidence_only",
      "default": "evidence_only",
      "title": "Remote Authority",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "response_artifact_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Response Artifact Ref",
      "type": "string"
    },
    "response_content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Response Content Hash",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "thesis_content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Thesis Content Hash",
      "type": "string"
    },
    "untrusted_content": {
      "const": true,
      "default": true,
      "title": "Untrusted Content",
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "platform",
    "publication_id",
    "external_ref",
    "thesis_content_hash",
    "published_at",
    "observation_deadline",
    "response_artifact_ref",
    "response_content_hash"
  ],
  "title": "PublishedThesis",
  "type": "object"
}
