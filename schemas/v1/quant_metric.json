{
  "additionalProperties": false,
  "properties": {
    "name": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unit": {
      "pattern": "^[a-z][a-z0-9_.%/-]{0,63}$",
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
      "title": "Value",
      "type": "string"
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "title": "QuantMetric",
  "type": "object"
}
