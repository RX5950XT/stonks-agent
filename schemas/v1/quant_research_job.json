{
  "$defs": {
    "QuantCostModelSpec": {
      "additionalProperties": false,
      "properties": {
        "fee_bps": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Fee Bps",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "slippage_bps": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Slippage Bps",
          "type": "string"
        }
      },
      "required": [
        "fee_bps",
        "slippage_bps"
      ],
      "title": "QuantCostModelSpec",
      "type": "object"
    },
    "QuantDatasetArtifact": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "title": "As Of",
          "type": "string"
        },
        "dataset_snapshot_id": {
          "format": "uuid",
          "title": "Dataset Snapshot Id",
          "type": "string"
        },
        "feature_spec": {
          "$ref": "#/$defs/QuantFeatureSpec"
        },
        "label_spec": {
          "$ref": "#/$defs/QuantLabelSpec"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/QuantDatasetRow"
          },
          "maxItems": 1000000,
          "minItems": 2,
          "title": "Rows",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_data_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Data Hash",
          "type": "string"
        },
        "source_snapshot_artifact_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Source Snapshot Artifact Ref",
          "type": "string"
        },
        "universe_spec": {
          "$ref": "#/$defs/QuantUniverseSpec"
        }
      },
      "required": [
        "dataset_snapshot_id",
        "source_snapshot_artifact_ref",
        "source_data_hash",
        "as_of",
        "feature_spec",
        "label_spec",
        "universe_spec",
        "rows"
      ],
      "title": "QuantDatasetArtifact",
      "type": "object"
    },
    "QuantDatasetRow": {
      "additionalProperties": false,
      "properties": {
        "event_at": {
          "title": "Event At",
          "type": "string"
        },
        "feature_available_at": {
          "title": "Feature Available At",
          "type": "string"
        },
        "features": {
          "items": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "historical_universe_known_at": {
          "title": "Historical Universe Known At",
          "type": "string"
        },
        "in_historical_universe": {
          "const": true,
          "title": "In Historical Universe",
          "type": "boolean"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "label": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Label",
          "type": "string"
        },
        "label_available_at": {
          "title": "Label Available At",
          "type": "string"
        },
        "label_outcome_at": {
          "title": "Label Outcome At",
          "type": "string"
        },
        "row_id": {
          "format": "uuid",
          "title": "Row Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "instrument_id",
        "event_at",
        "feature_available_at",
        "label_outcome_at",
        "label_available_at",
        "historical_universe_known_at",
        "in_historical_universe",
        "features",
        "label"
      ],
      "title": "QuantDatasetRow",
      "type": "object"
    },
    "QuantFeatureName": {
      "enum": [
        "return_1",
        "return_5",
        "volatility_5",
        "volume_change_1"
      ],
      "title": "QuantFeatureName",
      "type": "string"
    },
    "QuantFeatureSpec": {
      "additionalProperties": false,
      "properties": {
        "lookback_bars": {
          "maximum": 512,
          "minimum": 2,
          "title": "Lookback Bars",
          "type": "integer"
        },
        "names": {
          "items": {
            "$ref": "#/$defs/QuantFeatureName"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Names",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "names",
        "lookback_bars"
      ],
      "title": "QuantFeatureSpec",
      "type": "object"
    },
    "QuantLabelSpec": {
      "additionalProperties": false,
      "properties": {
        "horizon_bars": {
          "maximum": 64,
          "minimum": 1,
          "title": "Horizon Bars",
          "type": "integer"
        },
        "name": {
          "const": "forward_return",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "horizon_bars"
      ],
      "title": "QuantLabelSpec",
      "type": "object"
    },
    "QuantModelSpec": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "qlib_linear_ols",
          "title": "Algorithm",
          "type": "string"
        },
        "deterministic": {
          "const": true,
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "fit_intercept": {
          "const": false,
          "default": false,
          "title": "Fit Intercept",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "algorithm"
      ],
      "title": "QuantModelSpec",
      "type": "object"
    },
    "QuantRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "numpy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Numpy Version",
          "type": "string"
        },
        "pandas_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Pandas Version",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "qlib_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Qlib Commit",
          "type": "string"
        },
        "qlib_source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Qlib Source Hash",
          "type": "string"
        },
        "qlib_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Qlib Version",
          "type": "string"
        },
        "runtime_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sklearn_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Sklearn Version",
          "type": "string"
        },
        "worker_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Worker Version",
          "type": "string"
        }
      },
      "required": [
        "worker_version",
        "qlib_commit",
        "qlib_source_hash",
        "qlib_version",
        "runtime_hash",
        "python_version",
        "numpy_version",
        "pandas_version",
        "sklearn_version"
      ],
      "title": "QuantRuntimeIdentity",
      "type": "object"
    },
    "QuantSplitSpec": {
      "additionalProperties": false,
      "properties": {
        "embargo_observations": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Embargo Observations",
          "type": "integer"
        },
        "purge_observations": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Purge Observations",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "test_end": {
          "title": "Test End",
          "type": "string"
        },
        "test_start": {
          "title": "Test Start",
          "type": "string"
        },
        "train_end": {
          "title": "Train End",
          "type": "string"
        },
        "train_start": {
          "title": "Train Start",
          "type": "string"
        },
        "valid_end": {
          "title": "Valid End",
          "type": "string"
        },
        "valid_start": {
          "title": "Valid Start",
          "type": "string"
        }
      },
      "required": [
        "train_start",
        "train_end",
        "valid_start",
        "valid_end",
        "test_start",
        "test_end",
        "purge_observations",
        "embargo_observations"
      ],
      "title": "QuantSplitSpec",
      "type": "object"
    },
    "QuantUniverseSpec": {
      "additionalProperties": false,
      "properties": {
        "historical_membership_artifact_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Historical Membership Artifact Ref",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "instrument_ids",
        "historical_membership_artifact_ref"
      ],
      "title": "QuantUniverseSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_generation": {
      "minimum": 1,
      "title": "Attempt Generation",
      "type": "integer"
    },
    "attempt_nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Attempt Nonce",
      "type": "string"
    },
    "cost_model": {
      "$ref": "#/$defs/QuantCostModelSpec"
    },
    "dataset": {
      "$ref": "#/$defs/QuantDatasetArtifact"
    },
    "dataset_artifact_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Dataset Artifact Ref",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "string"
    },
    "feature_spec": {
      "$ref": "#/$defs/QuantFeatureSpec"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "label_spec": {
      "$ref": "#/$defs/QuantLabelSpec"
    },
    "model_spec": {
      "$ref": "#/$defs/QuantModelSpec"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "title": "Requested At",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/QuantRuntimeIdentity"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_policy": {
      "$ref": "#/$defs/QuantSplitSpec"
    },
    "universe_spec": {
      "$ref": "#/$defs/QuantUniverseSpec"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "job_id",
    "attempt_generation",
    "attempt_nonce",
    "dataset_artifact_ref",
    "dataset",
    "feature_spec",
    "label_spec",
    "universe_spec",
    "cost_model",
    "split_policy",
    "model_spec",
    "runtime",
    "requested_at",
    "deadline"
  ],
  "title": "QuantResearchJob",
  "type": "object"
}
