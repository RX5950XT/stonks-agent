{
  "$defs": {
    "RDSandboxDatasetRow": {
      "additionalProperties": false,
      "properties": {
        "event_at": {
          "title": "Event At",
          "type": "string"
        },
        "feature_available_at": {
          "title": "Feature Available At",
          "type": "string"
        },
        "features": {
          "items": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "prediction_at": {
          "title": "Prediction At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "instrument_id",
        "event_at",
        "feature_available_at",
        "prediction_at",
        "features"
      ],
      "title": "RDSandboxDatasetRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "cost_model_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cost Model Hash",
      "type": "string"
    },
    "dataset_snapshot_id": {
      "format": "uuid",
      "title": "Dataset Snapshot Id",
      "type": "string"
    },
    "feature_spec_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Feature Spec Hash",
      "type": "string"
    },
    "label_spec_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Label Spec Hash",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/RDSandboxDatasetRow"
      },
      "maxItems": 1000000,
      "minItems": 2,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_data_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Data Hash",
      "type": "string"
    },
    "split_policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Split Policy Hash",
      "type": "string"
    },
    "universe_spec_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Universe Spec Hash",
      "type": "string"
    }
  },
  "required": [
    "dataset_snapshot_id",
    "source_data_hash",
    "as_of",
    "feature_spec_hash",
    "label_spec_hash",
    "universe_spec_hash",
    "cost_model_hash",
    "split_policy_hash",
    "rows"
  ],
  "title": "RDSandboxDataset",
  "type": "object"
}
