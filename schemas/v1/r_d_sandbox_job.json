{
  "$defs": {
    "RDAgentCandidateKind": {
      "enum": [
        "factor"
      ],
      "title": "RDAgentCandidateKind",
      "type": "string"
    },
    "RDAgentProposal": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "draft_only",
          "default": "draft_only",
          "title": "Authority",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}/[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_kind": {
          "$ref": "#/$defs/RDAgentCandidateKind"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "generation_config_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Generation Config Hash",
          "type": "string"
        },
        "generation_input_artifact_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Generation Input Artifact Ref",
          "type": "string"
        },
        "generation_runtime_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Generation Runtime Hash",
          "type": "string"
        },
        "proposal_artifact_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Proposal Artifact Ref",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "raw_generation_artifact_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Raw Generation Artifact Ref",
          "type": "string"
        },
        "rd_agent_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Rd Agent Commit",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_artifact_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Source Artifact Ref",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "untrusted_content": {
          "const": true,
          "default": true,
          "title": "Untrusted Content",
          "type": "boolean"
        }
      },
      "required": [
        "proposal_id",
        "candidate_id",
        "candidate_kind",
        "rd_agent_commit",
        "proposal_artifact_ref",
        "generation_runtime_hash",
        "generation_config_hash",
        "generation_input_artifact_ref",
        "raw_generation_artifact_ref",
        "source",
        "source_hash",
        "source_artifact_ref",
        "generated_at"
      ],
      "title": "RDAgentProposal",
      "type": "object"
    },
    "RDSandboxDataset": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "title": "As Of",
          "type": "string"
        },
        "cost_model_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Cost Model Hash",
          "type": "string"
        },
        "dataset_snapshot_id": {
          "format": "uuid",
          "title": "Dataset Snapshot Id",
          "type": "string"
        },
        "feature_spec_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Feature Spec Hash",
          "type": "string"
        },
        "label_spec_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Label Spec Hash",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/RDSandboxDatasetRow"
          },
          "maxItems": 1000000,
          "minItems": 2,
          "title": "Rows",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_data_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Data Hash",
          "type": "string"
        },
        "split_policy_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Split Policy Hash",
          "type": "string"
        },
        "universe_spec_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Universe Spec Hash",
          "type": "string"
        }
      },
      "required": [
        "dataset_snapshot_id",
        "source_data_hash",
        "as_of",
        "feature_spec_hash",
        "label_spec_hash",
        "universe_spec_hash",
        "cost_model_hash",
        "split_policy_hash",
        "rows"
      ],
      "title": "RDSandboxDataset",
      "type": "object"
    },
    "RDSandboxDatasetRow": {
      "additionalProperties": false,
      "properties": {
        "event_at": {
          "title": "Event At",
          "type": "string"
        },
        "feature_available_at": {
          "title": "Feature Available At",
          "type": "string"
        },
        "features": {
          "items": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "prediction_at": {
          "title": "Prediction At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "instrument_id",
        "event_at",
        "feature_available_at",
        "prediction_at",
        "features"
      ],
      "title": "RDSandboxDatasetRow",
      "type": "object"
    },
    "RDSandboxRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "deterministic": {
          "const": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "image_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "rd_agent_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Rd Agent Commit",
          "type": "string"
        },
        "rd_agent_source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rd Agent Source Hash",
          "type": "string"
        },
        "runtime_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "worker_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Worker Version",
          "type": "string"
        }
      },
      "required": [
        "worker_version",
        "adapter_version",
        "rd_agent_commit",
        "rd_agent_source_hash",
        "runtime_hash",
        "image_digest",
        "python_version",
        "deterministic"
      ],
      "title": "RDSandboxRuntimeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_generation": {
      "minimum": 1,
      "title": "Attempt Generation",
      "type": "integer"
    },
    "attempt_nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Attempt Nonce",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/RDSandboxDataset"
    },
    "dataset_artifact_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Dataset Artifact Ref",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "string"
    },
    "evaluation_policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evaluation Policy Hash",
      "type": "string"
    },
    "execution_mode": {
      "const": "sandbox",
      "title": "Execution Mode",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "promotion_allowed": {
      "const": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "proposal": {
      "$ref": "#/$defs/RDAgentProposal"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "title": "Requested At",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RDSandboxRuntimeIdentity"
    },
    "sandbox_policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sandbox Policy Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "job_id",
    "attempt_generation",
    "attempt_nonce",
    "execution_mode",
    "proposal",
    "dataset_artifact_ref",
    "dataset",
    "evaluation_policy_hash",
    "sandbox_policy_hash",
    "runtime",
    "requested_at",
    "deadline",
    "promotion_allowed"
  ],
  "title": "RDSandboxJob",
  "type": "object"
}
