{
  "$defs": {
    "CandidateScanResult": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "ast_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Ast Hash",
          "type": "string"
        },
        "entrypoint": {
          "const": "compute",
          "title": "Entrypoint",
          "type": "string"
        },
        "node_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Node Count",
          "type": "integer"
        },
        "policy_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "scan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scan Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "source_hash",
        "policy_hash",
        "ast_hash",
        "node_count",
        "entrypoint",
        "accepted",
        "scan_hash"
      ],
      "title": "CandidateScanResult",
      "type": "object"
    },
    "DraftArtifact": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Byte Count",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "draft_only": {
          "const": true,
          "title": "Draft Only",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/DraftArtifactKind"
        },
        "media_type": {
          "enum": [
            "text/x-python",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "content_hash",
        "byte_count",
        "media_type",
        "draft_only"
      ],
      "title": "DraftArtifact",
      "type": "object"
    },
    "DraftArtifactKind": {
      "enum": [
        "source",
        "predictions",
        "static_scan"
      ],
      "title": "DraftArtifactKind",
      "type": "string"
    },
    "RDSandboxRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "deterministic": {
          "const": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "image_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "rd_agent_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Rd Agent Commit",
          "type": "string"
        },
        "rd_agent_source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rd Agent Source Hash",
          "type": "string"
        },
        "runtime_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Runtime Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "worker_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Worker Version",
          "type": "string"
        }
      },
      "required": [
        "worker_version",
        "adapter_version",
        "rd_agent_commit",
        "rd_agent_source_hash",
        "runtime_hash",
        "image_digest",
        "python_version",
        "deterministic"
      ],
      "title": "RDSandboxRuntimeIdentity",
      "type": "object"
    },
    "SandboxPrediction": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "predicted_return": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Predicted Return",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "predicted_return"
      ],
      "title": "SandboxPrediction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}/[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Candidate Id",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "prediction_artifact": {
      "$ref": "#/$defs/DraftArtifact"
    },
    "predictions": {
      "items": {
        "$ref": "#/$defs/SandboxPrediction"
      },
      "maxItems": 1000000,
      "minItems": 2,
      "title": "Predictions",
      "type": "array"
    },
    "process_isolation": {
      "const": "fresh_container",
      "title": "Process Isolation",
      "type": "string"
    },
    "proposal_id": {
      "format": "uuid",
      "title": "Proposal Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RDSandboxRuntimeIdentity"
    },
    "sandbox_instance_id": {
      "format": "uuid",
      "title": "Sandbox Instance Id",
      "type": "string"
    },
    "sandbox_policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sandbox Policy Hash",
      "type": "string"
    },
    "scan": {
      "$ref": "#/$defs/CandidateScanResult"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_artifact": {
      "$ref": "#/$defs/DraftArtifact"
    }
  },
  "required": [
    "sandbox_instance_id",
    "proposal_id",
    "candidate_id",
    "runtime",
    "sandbox_policy_hash",
    "scan",
    "source_artifact",
    "prediction_artifact",
    "predictions",
    "output_hash",
    "process_isolation",
    "generated_at"
  ],
  "title": "RDSandboxRunResult",
  "type": "object"
}
