{
  "additionalProperties": false,
  "description": "Exact immutable trading reference included in the report JSON truth.",
  "properties": {
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "ref_id": {
      "format": "uuid",
      "title": "Ref Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ref_id",
    "content_hash"
  ],
  "title": "ReportReference",
  "type": "object"
}
