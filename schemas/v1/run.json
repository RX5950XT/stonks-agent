{
  "$defs": {
    "RunState": {
      "enum": [
        "pending",
        "running",
        "degraded",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "config_snapshot_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Config Snapshot Ref",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "policy_snapshot_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Policy Snapshot Ref",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    }
  },
  "required": [
    "run_id",
    "state",
    "as_of",
    "created_at",
    "deadline",
    "policy_snapshot_ref",
    "config_snapshot_ref"
  ],
  "title": "Run",
  "type": "object"
}
