{
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_payload_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Event Payload Hash",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "title": "Occurred At",
      "type": "string"
    },
    "payload_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Payload Ref",
      "type": "string"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Hash"
    },
    "producer": {
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "event_type",
    "payload_ref",
    "event_payload_hash",
    "producer",
    "occurred_at"
  ],
  "title": "RunEvent",
  "type": "object"
}
