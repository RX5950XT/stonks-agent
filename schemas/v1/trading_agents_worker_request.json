{
  "$defs": {
    "EvidenceCategory": {
      "enum": [
        "market",
        "fundamentals",
        "news",
        "sentiment",
        "macro"
      ],
      "type": "string"
    },
    "SignedEvidenceArtifact": {
      "additionalProperties": false,
      "description": "A short-lived capability for exactly one content-addressed evidence item.",
      "properties": {
        "artifact_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Artifact Ref",
          "type": "string"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/EvidenceCategory"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signed_url": {
          "maxLength": 4096,
          "minLength": 20,
          "title": "Signed Url",
          "type": "string"
        },
        "untrusted_content": {
          "const": true,
          "default": true,
          "title": "Untrusted Content",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "artifact_ref",
        "signed_url",
        "expires_at",
        "available_at",
        "category"
      ],
      "title": "SignedEvidenceArtifact",
      "type": "object"
    },
    "WorkerProfile": {
      "enum": [
        "paper",
        "backtest",
        "production"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Allowed Evidence Ids",
      "type": "array"
    },
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "attempt_generation": {
      "minimum": 1,
      "title": "Attempt Generation",
      "type": "integer"
    },
    "attempt_nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Attempt Nonce",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/SignedEvidenceArtifact"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "horizon": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Horizon",
      "type": "string"
    },
    "instrument_id": {
      "format": "uuid",
      "title": "Instrument Id",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/WorkerProfile"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[A-Z0-9][A-Z0-9.-]*$",
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "job_id",
    "attempt_generation",
    "attempt_nonce",
    "profile",
    "instrument_id",
    "symbol",
    "as_of",
    "horizon",
    "allowed_evidence_ids",
    "evidence",
    "deadline"
  ],
  "title": "TradingAgentsWorkerRequest",
  "type": "object"
}
