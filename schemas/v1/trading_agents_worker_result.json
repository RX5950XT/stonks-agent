{
  "$defs": {
    "AgentOpinion": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "title": "As Of",
          "type": "string"
        },
        "calibration": {
          "$ref": "#/$defs/ConfidenceCalibration"
        },
        "confidence": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Confidence",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "instrument_id": {
          "format": "uuid",
          "title": "Instrument Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "opinion_id": {
          "format": "uuid",
          "title": "Opinion Id",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "recommendation": {
          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "thesis": {
          "minLength": 1,
          "title": "Thesis",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "opinion_id",
        "instrument_id",
        "as_of",
        "horizon",
        "recommendation",
        "thesis",
        "confidence",
        "calibration",
        "producer",
        "model_version"
      ],
      "title": "AgentOpinion",
      "type": "object"
    },
    "AnalysisBundle": {
      "additionalProperties": false,
      "properties": {
        "analyst_artifact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Analyst Artifact Ids",
          "type": "array"
        },
        "as_of": {
          "title": "As Of",
          "type": "string"
        },
        "bundle_id": {
          "format": "uuid",
          "title": "Bundle Id",
          "type": "string"
        },
        "debate_artifact_refs": {
          "default": [],
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Debate Artifact Refs",
          "type": "array"
        },
        "model_usage": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelUsage"
          },
          "title": "Model Usage",
          "type": "array"
        },
        "opinion_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Opinion Ids",
          "type": "array"
        },
        "research_plan_ref": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Plan Ref"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "worker_version": {
          "minLength": 1,
          "title": "Worker Version",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "run_id",
        "as_of",
        "analyst_artifact_ids",
        "worker_version"
      ],
      "title": "AnalysisBundle",
      "type": "object"
    },
    "ConfidenceCalibration": {
      "enum": [
        "uncalibrated",
        "calibrated"
      ],
      "title": "ConfidenceCalibration",
      "type": "string"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "latency_ms"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_opinion": {
      "$ref": "#/$defs/AgentOpinion"
    },
    "analysis_bundle": {
      "$ref": "#/$defs/AnalysisBundle"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "analysis_bundle",
    "agent_opinion"
  ],
  "title": "TradingAgentsWorkerResult",
  "type": "object"
}
